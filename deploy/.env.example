# Copy this file to /opt/mycenter/deploy/.env on the VPS, never into Git.
# The real file must be owned by root and have mode 600.

MYCENTER_DOMAIN=mycenter.example.com
ACME_EMAIL=admin@example.com
MYCENTER_PUBLIC_IPV4=203.0.113.10

# deploy.sh replaces these placeholders on the VPS. Do not generate or commit
# real session or registration secrets in the source checkout.
MYCENTER_IMAGE_TAG=SET_FROM_GIT
MYCENTER_SESSION_KEY=GENERATE_ON_VPS
MYCENTER_REGISTRATION_TOKEN=GENERATE_ON_VPS
MYCENTER_BOOTSTRAP_ACTIVE=true

ACME_PRODUCTION=false
MYCENTER_NEW_ACCOUNTS=false
MYCENTER_ENABLE_IPV6=false

MYCENTER_SOURCE_DIR=/opt/mycenter/src
MYCENTER_DEPLOY_DIR=/opt/mycenter/deploy
MYCENTER_STATE_DIR=/opt/mycenter/state
MYCENTER_CONFIG_PATH=/opt/mycenter/deploy/config.json
